# Public browser configuration only. Never put Gemini, service-role, or AI_ENGINE_TOKEN secrets here.
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=http://127.0.0.1:55441
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Customer app login = Supabase phone OTP (local stack: test phone numbers/OTP are configured in movafresh-platform/backend/supabase/config.toml).
# All prices, discounts, capacity and charge schedules are returned by the backend (POST /api/v2/subscription/preview); the web never computes them.
# Bảng demo /dev của app vận hành (đồng hồ, job, dữ liệu mẫu, tiền ngân hàng giả). CHỈ bật ở máy cục bộ; backend cần DEV_TOOLS_ENABLED=true.
VITE_DEV_TOOLS=false

# Đăng nhập Zalo OAuth v4 PKCE (khóa bí mật chỉ nằm ở backend, không bao giờ đưa vào đây).
VITE_ZALO_APP_ID=
VITE_ZALO_REDIRECT_URI=http://localhost:5173/auth/zalo/callback

# Bật chế độ Zalo Mini App (tự bật khi chạy npm run zmp:build).
VITE_ZALO_MINIAPP=false
